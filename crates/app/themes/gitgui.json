{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "gitgui",
  "author": "gitgui",
  "themes": [
    {
      "name": "gitgui Dark",
      "appearance": "dark",
      "style": {
        "background": "#1e1e1e",
        "panel.background": "#252526",
        "elevated_surface.background": "#252a31",
        "border": "#3c3c3c",
        "border.variant": "#333333",
        "text": "#d4d4d4",
        "text.muted": "#858585",
        "text.accent": "#4fc1ff",
        "link_text.hover": "#3794ff",
        "element.background": "#3a3d41",
        "element.hover": "#4a4d51",
        "element.selected": "#264f78",
        "ghost_element.hover": "#2a2d2e",
        "editor.background": "#1e1e1e",
        "editor.foreground": "#d4d4d4",
        "editor.line_number": "#6e7681",
        "editor.active_line.background": "#1b2a38",
        "editor.subheader.background": "#1f2a36",
        "editor.gutter.background": "#232323",
        "editor.indent_guide": "#4a4f57",
        "created": "#4ec9b0",
        "created.background": "#1d3b2c",
        "deleted": "#f48771",
        "deleted.background": "#4b2326",
        "modified": "#e5c07b",
        "warning": "#e5c07b",
        "accents": ["#4fc1ff", "#c586c0", "#dcdcaa", "#4ec9b0", "#ce9178", "#569cd6", "#b5cea8", "#d16969"],
        "syntax": {
          "attribute": { "color": "#9cdcfe" },
          "boolean": { "color": "#569cd6" },
          "comment": { "color": "#6a9955", "font_style": "italic" },
          "comment.doc": { "color": "#6a9955", "font_style": "italic" },
          "constant": { "color": "#4fc1ff" },
          "constructor": { "color": "#4ec9b0" },
          "embedded": { "color": "#d4d4d4" },
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "font_weight": 700 },
          "enum": { "color": "#4ec9b0" },
          "function": { "color": "#dcdcaa" },
          "keyword": { "color": "#c586c0" },
          "label": { "color": "#c8c8c8" },
          "link_uri": { "color": "#3794ff" },
          "number": { "color": "#b5cea8" },
          "operator": { "color": "#d4d4d4" },
          "preproc": { "color": "#c586c0" },
          "property": { "color": "#9cdcfe" },
          "punctuation": { "color": "#d4d4d4" },
          "punctuation.bracket": { "color": "#ffd700" },
          "punctuation.special": { "color": "#569cd6" },
          "string": { "color": "#ce9178" },
          "string.escape": { "color": "#d7ba7d" },
          "string.regex": { "color": "#d16969" },
          "string.special": { "color": "#d7ba7d" },
          "tag": { "color": "#569cd6" },
          "tag.attribute": { "color": "#9cdcfe" },
          "text.literal": { "color": "#ce9178" },
          "title": { "color": "#569cd6", "font_weight": 700 },
          "type": { "color": "#4ec9b0" },
          "type.builtin": { "color": "#569cd6" },
          "variable": { "color": "#9cdcfe" },
          "variable.builtin": { "color": "#569cd6" },
          "variable.special": { "color": "#569cd6" },
          "variant": { "color": "#4fc1ff" }
        }
      }
    }
  ]
}
